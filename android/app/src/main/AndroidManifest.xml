<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HostelManagement"
        android:usesCleartextTraffic="true">

        <!-- Student Login Activity (Launcher) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Student Registration Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".activities.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Student Dashboard Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Room Availability Activity -->
        <activity
            android:name=".activities.RoomAvailabilityActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Hostel Application Activity -->
        <activity
            android:name=".activities.HostelApplicationActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Application Status Activity -->
        <activity
            android:name=".activities.MyApplicationActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- My Room Details Activity -->
        <activity
            android:name=".activities.MyRoomActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Student Profile Activity -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Vacancy / Leave Request Activity -->
        <activity
            android:name=".activities.VacancyLeaveActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
